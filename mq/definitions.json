{
  "rabbit_version": "3.13.0",
  "vhosts": [
    { "name": "/" }
  ],
  "policies": [
    {
      "vhost": "/",
      "name": "ha-all",
      "pattern": "^q\\.",
      "apply-to": "queues",
      "definition": { "ha-mode": "all", "ha-sync-mode": "automatic" },
      "priority": 0
    }
  ],
  "exchanges": [
    { "name": "cmd.direct", "vhost": "/", "type": "direct", "durable": true, "auto_delete": false, "internal": false, "arguments": {} },
    { "name": "cmd.topic", "vhost": "/", "type": "topic", "durable": true, "auto_delete": false, "internal": false, "arguments": {} },
    { "name": "cmd.dead.dlx", "vhost": "/", "type": "direct", "durable": true, "auto_delete": false, "internal": false, "arguments": {} }
  ],
  "queues": [
    {
      "name": "q.cmd.email",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-dead-letter-exchange": "cmd.dead.dlx",
        "x-dead-letter-routing-key": "q.cmd.email"
      }
    },
    {
      "name": "q.cmd.email.dlq",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    },
    {
      "name": "q.cmd.prep",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-dead-letter-exchange": "cmd.dead.dlx",
        "x-dead-letter-routing-key": "q.cmd.prep"
      }
    },
    {
      "name": "q.cmd.prep.dlq",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    },
    {
      "name": "q.cmd.voucher",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-dead-letter-exchange": "cmd.dead.dlx",
        "x-dead-letter-routing-key": "q.cmd.voucher"
      }
    },
    {
      "name": "q.cmd.voucher.dlq",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    }
  ],
  "bindings": [
    { "source": "cmd.direct", "vhost": "/", "destination": "q.cmd.email", "destination_type": "queue", "routing_key": "email.send", "arguments": {} },
    { "source": "cmd.topic", "vhost": "/", "destination": "q.cmd.email", "destination_type": "queue", "routing_key": "email.*", "arguments": {} },

    { "source": "cmd.direct", "vhost": "/", "destination": "q.cmd.prep", "destination_type": "queue", "routing_key": "prep.ticket", "arguments": {} },
    { "source": "cmd.topic", "vhost": "/", "destination": "q.cmd.prep", "destination_type": "queue", "routing_key": "prep.#", "arguments": {} },

    { "source": "cmd.direct", "vhost": "/", "destination": "q.cmd.voucher", "destination_type": "queue", "routing_key": "voucher.gen", "arguments": {} },
    { "source": "cmd.topic", "vhost": "/", "destination": "q.cmd.voucher", "destination_type": "queue", "routing_key": "voucher.*", "arguments": {} },

    { "source": "cmd.dead.dlx", "vhost": "/", "destination": "q.cmd.email.dlq", "destination_type": "queue", "routing_key": "q.cmd.email", "arguments": {} },
    { "source": "cmd.dead.dlx", "vhost": "/", "destination": "q.cmd.prep.dlq", "destination_type": "queue", "routing_key": "q.cmd.prep", "arguments": {} },
    { "source": "cmd.dead.dlx", "vhost": "/", "destination": "q.cmd.voucher.dlq", "destination_type": "queue", "routing_key": "q.cmd.voucher", "arguments": {} }
  ]
}
